# Ayni — frontend environment variables
# Copy to .env for local development:  cp .env.example .env
# If these are absent, the app runs in Demo mode (mock service) — see README.md.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Maps + routing (Phase 3) — ALL OPTIONAL. Defaults work with zero new
# env vars: OpenFreeMap vector style + mock/demo routing (no OSRM calls).
# See MAPS.md for provider usage policies and production guidance.
# ---------------------------------------------------------------------------

# MapLibre style JSON URL (OpenStreetMap-based vector tiles, no key).
# Swap for any compatible style (e.g. self-hosted TileServer GL / Martin).
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Raster tile template, used ONLY if the vector style fails to load.
# Standard OSM tiles: light use only, per the OSM Tile Usage Policy.
# VITE_MAP_RASTER_FALLBACK_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Routing provider: mock (default, demo estimates, no network) | osrm
# (live development routing via the public demo server, opt-in) | off
# (no route lines). Set to osrm only for light development use.
# VITE_ROUTING_PROVIDER=mock

# Master routing switch. false disables route lines entirely (markers only).
# VITE_ROUTING_ENABLED=true

# OSRM endpoint. Default is the public demo server (max 1 req/s, dev only).
# For production, self-host OSRM and point this at your instance.
# VITE_OSRM_BASE_URL=https://router.project-osrm.org

# Minimum gap between OSRM request starts (ms). Default 1100 respects the
# demo-server policy. Only lower this for a server you operate yourself.
# VITE_OSRM_MIN_INTERVAL_MS=1100

# Per-request OSRM timeout (ms) and in-memory route cache TTL (ms).
# TTL 0 means "never expire" — set deliberately only.
# VITE_OSRM_TIMEOUT_MS=10000
# VITE_OSRM_CACHE_TTL_MS=600000

# Attempt 3D building extrusion where the map style supports it.
# VITE_MAP_3D_ENABLED=true

# ---------------------------------------------------------------------------
# Optimization engine — ALL OPTIONAL. Defaults: mock places + mock
# routing (demo search, zero external calls). Live search needs BOTH
# VITE_PLACES_PROVIDER=photon (or overpass/proxy) AND
# VITE_ROUTING_PROVIDER=osrm; mixed configs fall back to the demo
# path. See ENGINE.md.
# ---------------------------------------------------------------------------

# Places provider: mock (default, room demo spots) | photon (live
# OpenStreetMap data via the Photon API, queried directly from the
# browser — the RECOMMENDED live default as of 2026-11-17: Photon
# category search works from networks where Overpass is blocked) |
# overpass (live OpenStreetMap data via the Overpass API, queried
# directly from the browser, opt-in) | proxy (live data via the
# `places-search` Supabase Edge Function, which queries Overpass
# server-side — use this when browsers run on networks Overpass
# rejects, e.g. cloud/datacenter egress; the function must be
# deployed, see SUPABASE.md) | off (disables search). Overpass and
# proxy remain available for self-hosters.
# VITE_PLACES_PROVIDER=mock

# Photon endpoint. Default is the public instance (shared
# infrastructure, fair use only). Self-host Photon for anything
# beyond light development use.
# VITE_PHOTON_URL=https://photon.komoot.io

# Overpass endpoint. Default is the public instance (shared
# infrastructure, fair use only). This URL is always tried FIRST; if
# it fails, the client falls back sequentially to the built-in mirrors
# overpass.kumi.systems and overpass.private.coffee (see ENGINE.md).
# Self-host or use a mirror for anything beyond light development use.
# VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Overpass request timeout (ms). Matches the 45s Overpass QL timeout.
# Weak public mirrors need more patience than the 25s the main
# instance's guidance suggests; the QL timeout derives from this value.
# VITE_OVERPASS_TIMEOUT_MS=45000

# Master engine switch. false disables the smart-search panel.
# VITE_OPTIMIZATION_ENABLED=true

# Max candidates carried into routing after pre-filtering (1..20).
# VITE_OPTIMIZATION_MAX_CANDIDATES=12

# Max unique OSRM route pairs per search. Exceeding this aborts the
# search with a clear error instead of truncating results.
# VITE_OPTIMIZATION_MAX_OSRM_REQUESTS=60

# Max places requested per Overpass search area (1..50).
# VITE_OPTIMIZATION_PLACES_PER_AREA=30

# ---------------------------------------------------------------------------
# NEVER put the service-role key here, and NEVER prefix it with VITE_.
# SUPABASE_SERVICE_ROLE_KEY is an Edge Function secret ONLY:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...   (server-side)
# It bypasses Row Level Security. Exposing it in browser code would let
# anyone read/write every table. See SUPABASE.md.
# ---------------------------------------------------------------------------
